{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "scripts/prune-retired-emits.mjs",
    "scripts/copy-release-manifest.mjs",
    "release/velocast-release.json"
  ],
  "globalEnv": [
    "APPLE_MUSIC_MEDIA_USER_TOKEN",
    "CARGO_TARGET_DIR",
    "DISPLAY",
    "INIT_CWD",
    "HTTPS_PROXY",
    "LD_LIBRARY_PATH",
    "VELOCAST_ARTIFACT_BASE_URL",
    "VELOCAST_ARTIFACT_DIR",
    "VELOCAST_ARTIFACT_MANIFEST_SHA256",
    "VELOCAST_CACHE_DIR",
    "VELOCAST_DEBUG",
    "VELOCAST_HTTPS_PROXY",
    "VELOCAST_OFFLINE",
    "VELOCAST_RELEASE_MANIFEST",
    "VELOCAST_RENDERER_BINARY",
    "VELOCAST_TEST_GLIBC_VERSION",
    "VELOCAST_TEST_LIBC",
    "VELOCAST_TEST_OS_VERSION",
    "WAYLAND_DISPLAY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
