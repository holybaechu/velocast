{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "scripts/build/copy-release-manifest.mjs",
    "release/velocast-release.json"
  ],
  "globalEnv": [
    "APPLE_MUSIC_MEDIA_USER_TOKEN",
    "CARGO_TARGET_DIR",
    "DISPLAY",
    "INIT_CWD",
    "HTTPS_PROXY",
    "LD_LIBRARY_PATH",
    "VELOCAST_ARTIFACT_BASE_URL",
    "VELOCAST_ARTIFACT_DIR",
    "VELOCAST_ARTIFACT_MANIFEST_SHA256",
    "VELOCAST_CACHE_DIR",
    "VELOCAST_DEBUG",
    "VELOCAST_HTTPS_PROXY",
    "VELOCAST_OFFLINE",
    "VELOCAST_RELEASE_MANIFEST",
    "VELOCAST_RENDERER_BINARY",
    "VELOCAST_TEST_GLIBC_VERSION",
    "VELOCAST_TEST_LIBC",
    "VELOCAST_TEST_OS_VERSION",
    "WAYLAND_DISPLAY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/THIRD_PARTY_NOTICES"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "env": [
        "CHROME_PATH",
        "VELOCAST_BROWSER_BINARY",
        "VELOCAST_PREVIEW_GATE_CLI"
      ],
      "outputs": []
    }
  }
}
