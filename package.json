{
  "name": "@velocast/repo",
  "private": true,
  "scripts": {
    "electron:verify": "node scripts/verify/verify-electron-portable.mjs",
    "electron:package": "node scripts/release/package-electron-runtime.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint --only",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:rust": "cargo test --workspace",
    "test:policy": "cargo test -p velocast-protocol -p velocast-renderer-policy",
    "check:fast": "pnpm contracts:check && pnpm test:policy && pnpm check-types && pnpm lint && pnpm test --concurrency=1 && pnpm test:scripts",
    "contracts:generate": "node scripts/contracts/generate-renderer-contracts.mjs",
    "contracts:check": "node scripts/contracts/generate-renderer-contracts.mjs --check",
    "release:verify": "node scripts/release/verify-release-manifest.mjs",
    "release:test": "turbo run build --filter=velocast && node --test --test-concurrency=2 scripts/tests/release-*.test.mjs scripts/tests/package-audit.test.mjs scripts/tests/windows-*.test.mjs",
    "release:package-audit": "node scripts/release/audit-package-tarballs.mjs",
    "release:pack-public": "node scripts/release/pack-public-packages.mjs",
    "release:package-native": "node scripts/release/package-native-artifact.mjs",
    "release:assemble": "node scripts/release/assemble-release-manifest.mjs",
    "velocast": "node packages/cli/dist/bin.js",
    "test:scripts": "turbo run build --filter=velocast && node --test --test-concurrency=2 scripts/tests/*.test.mjs",
    "release:private-rc": "node scripts/release/windows-private-rc-orchestrator.mjs",
    "release:prepare-private-rc": "node scripts/release/prepare-windows-private-rc-manifest.mjs",
    "release:sync-windows": "node scripts/release/sync-windows-runtime-declarations.mjs",
    "verify:preview": "node scripts/verify/verify-competitive-preview.mjs",
    "verify:authored-audio": "node scripts/verify/verify-authored-audio.mjs",
    "verify:web-audio-clock": "node scripts/verify/verify-web-audio-clock.mjs",
    "profile:renderer": "pwsh -NoProfile -File scripts/profiling/measure-renderer-resources.ps1",
    "profile:check-timestamp": "pwsh -NoProfile -File scripts/profiling/test-renderer-profiler-timestamp.ps1",
    "test:profiling": "pwsh -NoProfile -File scripts/profiling/test-measure-renderer-resources.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-turbo": "^2.11.2",
    "prettier": "^3.9.8",
    "tar": "^7.5.22",
    "turbo": "^2.11.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0",
    "velocast": "workspace:*"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
