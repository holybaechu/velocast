{
  "name": "velocast",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic native video rendering for JavaScript projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "velocast": "./dist/bin.js"
  },
  "main": "./dist/commands.js",
  "types": "./dist/commands.d.ts",
  "exports": {
    "./source-output": {
      "types": "./dist/source-output.d.ts",
      "default": "./dist/source-output.js"
    },
    "./preview": {
      "types": "./dist/preview-server.d.ts",
      "default": "./dist/preview-server.js"
    },
    ".": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/prune-retired-emits.mjs cli && tsc -p tsconfig.build.json && node ../../scripts/copy-release-manifest.mjs cli",
    "lint": "eslint src eslint.config.mjs --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --dir src",
    "velocast": "tsx src/bin.ts"
  },
  "dependencies": {
    "@velocast/core": "workspace:0.1.0",
    "@velocast/preview": "workspace:0.1.0",
    "cac": "^7.0.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "undici": "^8.10.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
