{
  "name": "@velocast/gsap",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global": {
      "default": "./dist/global.js"
    },
    "./browser/velocast-gsap.global.js": {
      "default": "./browser/velocast-gsap.global.js"
    }
  },
  "files": [
    "dist",
    "browser"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.config.ts && node ../../scripts/copy-release-manifest.mjs gsap",
    "lint": "eslint src vite.config.ts eslint.config.mjs --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@velocast/core": "workspace:0.1.0"
  },
  "peerDependencies": {
    "gsap": "^3.0.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
